# Copy to .env and edit. Every variable is optional: with no .env the app runs in mock mode.
# Never commit .env.

# development | test | production
APP_ENV=development

# --- LLM provider ---------------------------------------------------------------------------
# mock = canned realistic output, no network, no key. openai_compatible = any OpenAI-style API.
LLM_PROVIDER=mock
# Any OpenAI-compatible endpoint (Groq, xAI, Gemini's OpenAI endpoint, OpenRouter, Ollama...)
LLM_BASE_URL=https://api.groq.com/openai/v1
# Required when LLM_PROVIDER=openai_compatible. Never share or log it.
LLM_API_KEY=
# Required when LLM_PROVIDER=openai_compatible (model ID from your provider's console)
LLM_MODEL=
# Per-call timeout in seconds
LLM_TIMEOUT_SECONDS=30
# Low temperature keeps the JSON structure consistent
LLM_TEMPERATURE=0.2
# Output token cap per call
LLM_MAX_OUTPUT_TOKENS=8192
# Send response_format={"type": "json_object"} (auto-disabled if the provider rejects it)
LLM_JSON_MODE=true
# Retries for rate limits, timeouts and outages
LLM_MAX_TRANSIENT_RETRIES=2
# Corrective retries when the model returns malformed output
LLM_MAX_REPAIR_ATTEMPTS=1
# Wall-clock cap across all attempts of one request (seconds)
LLM_TOTAL_BUDGET_SECONDS=90
# Longest provider "retry after" wait the backend will honour (seconds)
LLM_MAX_RETRY_AFTER_SECONDS=10
# Reasoning effort for reasoning models such as gpt-oss: low | medium | high (blank = provider default)
LLM_REASONING_EFFORT=
# Run the contradiction, risk and dependency checks after extraction
LLM_ENABLE_INTELLIGENCE=true
# How many earlier analyses to compare against for cross-document contradictions
CROSS_DOC_CONTEXT_LIMIT=5

# --- Input limits ---------------------------------------------------------------------------
MAX_TITLE_CHARS=200
MAX_INPUT_CHARS=50000
# Request body limit in bytes (256 KB)
MAX_BODY_BYTES=262144

# --- Storage, CORS, misc --------------------------------------------------------------------
# SQLite file; the folder is created if missing
DATABASE_PATH=./data/analyses.db
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Simulated delay in mock mode (tests use 0)
MOCK_LATENCY_MS=300
LOG_LEVEL=INFO
# How long a login session stays valid (days)
SESSION_DAYS=30

# --- Example: Groq --------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key-here
# LLM_MODEL=model-id-from-groq-console
